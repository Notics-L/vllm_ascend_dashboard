# GitHub 启动兜底配置（运行时配置由系统配置页面写入 MySQL）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=vllm-project
GITHUB_REPO=vllm-ascend

# 贡献者评估系统多仓库采集配置
# 格式: owner/repo,owner/repo  (留空则使用 GITHUB_OWNER/GITHUB_REPO)
# 示例: CONTRIBUTOR_REPOS=vllm-project/vllm-ascend,vllm-project/other-repo
CONTRIBUTOR_REPOS=

# 工号提取正则（从 GitHub email/bio 中匹配内部工号，如 Z0012345 或 30012345）
EMPLOYEE_ID_PATTERN=\bZ?\d{7,8}\b

# 数据库配置（开发和生产均使用 MySQL）
DATABASE_URL=mysql+aiomysql://dashboard:change-me@localhost:3306/vllm_dashboard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=60
MYSQL_DATABASE=vllm_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用配置
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# 数据文件存储目录，默认为根目录 data/
DATA_DIR=data

# 本地开发使用已持久化的演示资源指标，不连接 Kubernetes
RESOURCE_METRICS_REMOTE_URL=local-demo

# CI、模型同步、缓存、日报和 SMTP 等运行时业务配置存储在 MySQL，
# 通过系统配置页面管理，不在 .env 中维护。

# LLM API Keys（用于 AI 总结生成）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:8000/api/v1
# NPU 卡占用趋势
NPU_OCCUPANCY_UPSTREAM_URL=https://pod-history-api.test.osinfra.cn/api/v1/envs/history
NPU_OCCUPANCY_TIMEOUT_SECONDS=180
# 生产环境必须保持 true；仅受控开发环境可在证书链不可验证时设为 false。
NPU_OCCUPANCY_VERIFY_TLS=true
NPU_OCCUPANCY_MAX_WINDOW_SECONDS=2592000
