# Production Environment Configuration for vLLM Ascend Dashboard
# Copy this template to the external runtime path configured below and
# customize it for your environment. Do not keep the real file in the Git
# checkout and never commit it to version control.

# =============================================================================
# Runtime file and persistent resource locations
# =============================================================================
# In production this file itself lives outside the Git checkout.  The other
# runtime files must also be copied to the external directory before deploy.
DASHBOARD_COMPOSE_PROJECT=vllm_ascend_dashboard
DASHBOARD_RUNTIME_ENV_FILE=/etc/vllm-ascend-dashboard/production.env
DASHBOARD_LITELLM_CONFIG_FILE=/etc/vllm-ascend-dashboard/litellm_config.yaml
DASHBOARD_MYSQL_CONFIG_FILE=/etc/vllm-ascend-dashboard/mysql.cnf
DASHBOARD_BACKEND_VOLUME=vllm_ascend_dashboard_backend_data
DASHBOARD_BACKEND_LOG_VOLUME=vllm_ascend_dashboard_backend_logs
DASHBOARD_MYSQL_VOLUME=vllm_ascend_dashboard_mysql_data
DASHBOARD_NETWORK_NAME=vllm_ascend_dashboard_dashboard-network
DASHBOARD_REQUIRE_EXTERNAL_CONFIG=true

# =============================================================================
# Immutable image references (CI publishes the application image digests)
# =============================================================================
DASHBOARD_BACKEND_IMAGE=ghcr.io/your-org/vllm-ascend-dashboard-backend@sha256:replace-with-ci-digest
DASHBOARD_FRONTEND_IMAGE=ghcr.io/your-org/vllm-ascend-dashboard-frontend@sha256:replace-with-ci-digest
DASHBOARD_MYSQL_IMAGE=mysql@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
DASHBOARD_LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:76d036d18bb352ac3b4e0a84d5892b2cb2fe472e305bf2ac0619aef97fe6ced0

# =============================================================================
# GitHub bootstrap configuration
# =============================================================================
# Optional only.  The runtime token is encrypted in MySQL and managed from
# the System Config page after the first deployment.
# GITHUB_TOKEN=ghp_your_production_github_token_here
GITHUB_OWNER=vllm-project
GITHUB_REPO=vllm-ascend

# Multi-repo collection list for contributor board (owner/repo,owner/repo)
# Leave empty to default to GITHUB_OWNER/GITHUB_REPO
CONTRIBUTOR_REPOS=
# Employee ID extraction regex from GitHub email/bio
EMPLOYEE_ID_PATTERN=\bZ?\d{7,8}\b

# =============================================================================
# Database Configuration
# =============================================================================
# For MySQL (recommended for production)
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=vllm_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=your_secure_database_password_here

# Separate service accounts are retained when migrating an existing
# installation.  They are not business configuration and must remain outside
# version control.
CONTROL_DB_USER=control_svc
CONTROL_DB_PASSWORD=replace-with-existing-control-password
SCHEDULER_DB_USER=scheduler_svc
SCHEDULER_DB_PASSWORD=replace-with-existing-scheduler-password
COLLECTOR_DB_USER=collector_svc
COLLECTOR_DB_PASSWORD=replace-with-existing-collector-password
QUERY_DB_USER=query_svc
QUERY_DB_PASSWORD=replace-with-existing-query-password

# For MySQL (production only)
DATABASE_URL=mysql+aiomysql://dashboard:your_secure_database_password_here@mysql:3306/vllm_dashboard

# =============================================================================
# JWT Security Configuration
# =============================================================================
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Automatic schema changes are disabled in production. Use
# operations/production/migrate.sh through the guarded deployment flow.
AUTO_MIGRATE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=60

# =============================================================================
# Frontend Configuration
# =============================================================================
# API base URL - adjust based on your deployment
# For same server: http://localhost:8000/api/v1
# For different server: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# =============================================================================
# Port Configuration
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
MYSQL_PORT=3306

# =============================================================================
# Optional: SSL/TLS Configuration (if using nginx reverse proxy)
# =============================================================================
# SSL_CERT_PATH=/etc/nginx/certs/your_domain.crt
# SSL_KEY_PATH=/etc/nginx/certs/your_domain.key

# =============================================================================
# LiteLLM API Gateway Configuration
# =============================================================================
# Master key for LiteLLM management API
LITELLM_MASTER_KEY=sk-litellm-master-key-change-me
# LiteLLM proxy URL (set by docker-compose, no need to change)
LITELLM_PROXY_URL=http://litellm:4000
AGENT_SERVICE_ENABLED=false
AGENT_PROXY_ONLY=true
AGENT_PROXY_ALLOWED_HOSTS=litellm
# Provider API keys are NOT configured here — they are managed dynamically
# via the System Config → LLM Provider page in the dashboard UI.
# Backend syncs them to LiteLLM on startup via the /model/new API.

# =============================================================================
# Runtime business configuration
# =============================================================================
# CI/model synchronization, retention, cache, daily report, SMTP, LLM
# providers, and other business settings are stored in MySQL and managed
# through the System Config page. They are intentionally absent from this file.
