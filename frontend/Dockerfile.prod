# Production Dockerfile for vLLM Ascend Dashboard Frontend
# Multi-stage build for optimized image size

# Stage 1: Builder
# 国内网络环境使用镜像加速，若已配置 Docker daemon mirror 可改回 node:20-alpine
FROM docker.m.daocloud.io/library/node:20-alpine AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Copy dependency files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY . .

# Vite values are compiled into the static bundle at build time.  Keep the
# production default same-origin so an omitted build argument cannot point a
# user's browser at its own localhost.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# A localhost API is only valid for a developer's local process and must not
# be baked into a production image.
RUN case "$VITE_API_BASE_URL" in \
      http://localhost:*|https://localhost:*|http://127.0.0.1:*|https://127.0.0.1:*) \
        echo "VITE_API_BASE_URL must not target localhost in a production image" >&2; \
        exit 1 ;; \
    esac

RUN pnpm build


# Stage 2: Production
FROM docker.m.daocloud.io/library/nginx:alpine AS production

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user directories and set permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /var/run \
    && chmod -R 755 /var/cache/nginx /var/log/nginx /var/run

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/health || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
